* text=auto
*.sh text eol=lf
*.bat text eol=crlf
# shell 钩子没有扩展名，*.sh 规则匹配不到；必须是 LF，否则 Git for Windows 下 `#!/bin/sh` 解析失败
tools/hooks/* text eol=lf

# 许可证正文 / 根 LICENSE 一律 LF：文档里记的 SHA256 以仓库内形态为准（见 licenses/README.md）
licenses/*.txt text eol=lf
LICENSE text eol=lf
docs/archive/** -text

# 第一百一十三批：eval 真报告的 sha256 就是证据指纹，按提交进去的字节算；
# -text 禁止 text=auto 把它在 checkout 时改成 CRLF（改一个字节指纹就废）。
eval/report-*.json -text

# 出厂人设的字节数与 sha256 被测试钉死：禁止行尾转换（2026-10-30）
app/src/main/assets/persona/*.md -text

# 第三百二十七批：锚定集随包出厂，sha256 被 AnchorAsset 常量钉死；-text 禁止
# text=auto 的行尾转换（285 教训：CRLF 改一个字节指纹就废）。
app/src/main/assets/policy/anchor-set.jsonl -text
