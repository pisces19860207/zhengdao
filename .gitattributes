* text=auto
*.sh text eol=lf
*.bat text eol=crlf
# shell 钩子没有扩展名，*.sh 规则匹配不到；必须是 LF，否则 Git for Windows 下 `#!/bin/sh` 解析失败
tools/hooks/* text eol=lf
rootfs/agents.json text eol=lf
rootfs/agents.json.sig binary

# 许可证正文 / 根 LICENSE / 字体 OFL 一律 LF：文档里记的 SHA256 以仓库内形态为准（见 licenses/README.md）
licenses/*.txt text eol=lf
LICENSE text eol=lf
app/src/main/assets/fonts/OFL.txt text eol=lf
docs/archive/** -text

# 第一百一十三批：eval 真报告的 sha256 就是证据指纹，按提交进去的字节算；
# -text 禁止 text=auto 把它在 checkout 时改成 CRLF（改一个字节指纹就废）。
eval/report-*.json -text
