<?xml version="1.0" encoding="utf-8"?><!--
  证道 · 数据提取规则（API 31+；API ≤ 30 走 backup_rules.xml）。
  两个入口都在 AndroidManifest.xml：android:dataExtractionRules / android:fullBackupContent。

  云备份（cloud-backup）：排除整套"可重新下载/重建 + 体积不可控"的目录 —— 否则
  Google Drive 的 25 MB 配额必然撑不住，而且会把用户的工作内容上传到云端。
  设备迁移（device-transfer）：排除**纯系统层**（新机重装即可拿回）＋**凭据目录**
  （2026-10-14 第 2 期审计 N-3：`home/.claude` / `home/.hermes` 里是 API key，
  `oc` 里是 opencode 运行时的 serve.log —— 含明文口令；就近场迁移**不加密**，
  一旦迁出去不可撤销）。其余用户数据（home 本体 / workspace）仍留给本地迁移通道 ——
  那是同一台手机到另一台手机的近距离传输，不经云。整目录 `home` **故意不排**，
  门禁里有一条会红的断言钉着这件事（BackupRulesGuardTest）。

  改动前先看 docs/ERRATA.md E-121 与 docs/FEATURE-LEDGER.md §B 顺序 1（issue #19）。
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- 系统层：可重新下载 / 重建 -->
        <exclude domain="file" path="rootfs" />
        <exclude domain="file" path="termux-proot" />
        <exclude domain="file" path="proot-tmp" />
        <!-- 用户数据与运行时：体积不可控 -->
        <exclude domain="file" path="home" />
        <exclude domain="file" path="oc" />
        <!-- 「仅私有模式」的工作区（App 外部私有目录） -->
        <exclude domain="external" path="workspace" />
    </cloud-backup>
    <device-transfer>
        <!-- 只挡系统层：rootfs 与 proot 二进制在新机上重装一份更干净 -->
        <exclude domain="file" path="rootfs" />
        <exclude domain="file" path="termux-proot" />
        <exclude domain="file" path="proot-tmp" />
        <!-- 凭据（2026-10-14 第 2 期审计 N-3）：这两处是 API key，oc 里是
             opencode 运行时的 serve.log（含明文口令）；近场迁移不加密、不可撤销，
             所以不跟着走。用户数据本体仍不排（见文件顶部与门禁测试）。 -->
        <exclude domain="file" path="home/.claude" />
        <exclude domain="file" path="home/.hermes" />
        <exclude domain="file" path="oc" />
    </device-transfer>
</data-extraction-rules>
