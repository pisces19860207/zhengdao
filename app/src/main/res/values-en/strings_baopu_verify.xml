<?xml version="1.0" encoding="utf-8"?>
<!-- Batch 317 (verification made visible · plain-wording layer): every user-facing string
     for the one-line per-round verification verdict.

     Same practice as batches 158/198/212/242 - a file of its own instead of strings.xml, so
     this batch does not contend with batches 544/565 that are editing strings.xml.

     Three rules (dispatch 317 §一.2 / §二 - editing these values changes the wording only,
     never the criteria; the gate test pins which key each of the three states uses):
     1. the gate pins the KEY, not this English text;
     2. no internal token may appear in a value (PASS / FAIL / UNVERIFIABLE / sha256 / GapItem
        and that whole family) - VerifyVisibleGateTest scans both locale copies against
        VerifyNarrative.FORBIDDEN, case-insensitively;
     3. placeholders are positional string slots only (%1$s / %2$s); the counts are pinned by
        VerifyVisibleGateTest against PLACEHOLDER_COUNTS, so a value that gains or loses a slot
        fails the build instead of crashing at runtime. -->
<resources>
    <!-- three states (§一.2; detail = the missing items are nameable, bare = they are not) -->
    <string name="baopu_verify_pass">Checked: everything that had to be written is there, and the log lines up</string>
    <string name="baopu_verify_fail_detail">Not verified: missing %1$s. Want me to run it again</string>
    <string name="baopu_verify_fail_bare">Not verified: this round did not name which item fell short. Want me to run it again</string>
    <string name="baopu_verify_unverifiable_detail">I could not call this one: missing %1$s. Take a look and decide</string>
    <string name="baopu_verify_unverifiable_bare">I could not call this one: no reading came back to compare. Take a look and decide</string>

    <!-- failure looks like a product (§二, three kinds, each with a way out) -->
    <string name="baopu_verify_page_read">The page did not come through</string>
    <string name="baopu_verify_no_evidence">I cannot confirm this</string>
    <string name="baopu_verify_needs_tap">I need one tap from you on screen: %1$s</string>
    <string name="baopu_verify_needs_tap_nowhere">I need one tap from you on screen: I could not find the exact spot</string>

    <!-- the basis clause behind the verdict (tap it to open the evidence) -->
    <string name="baopu_verify_basis_files">%1$s file(s) landed this round</string>
    <string name="baopu_verify_basis_rows">%1$s reading(s) lined up</string>
    <string name="baopu_verify_basis_gate">%1$s item(s) did not clear the closing check</string>
    <string name="baopu_verify_basis_read">The page in question: %1$s</string>
    <string name="baopu_verify_basis_tap">Once you tap it, I pick the run back up</string>
    <string name="baopu_verify_basis_bare">No reading came back to compare</string>

    <!-- evidence sheet opened from that line (file paths / log rows) -->
    <string name="baopu_verify_evidence_title">Evidence you can open</string>
    <string name="baopu_verify_evidence_more">%1$s more not listed</string>
    <string name="baopu_verify_evidence_none">No file or log row to line up this round</string>
    <string name="baopu_verify_toggle_open">Open the basis for this round</string>
    <string name="baopu_verify_toggle_close">Close the basis for this round</string>

    <!-- way-out buttons (each must land somewhere real, criterion ③) -->
    <string name="baopu_verify_act_retry">Retry</string>
    <string name="baopu_verify_act_swap">Another way</string>
    <string name="baopu_verify_act_xuanlan">Open in Xuanlan</string>
    <string name="baopu_verify_act_again">Run it again</string>
    <string name="baopu_verify_act_note">Leave it, note it down</string>
    <string name="baopu_verify_act_go_tap">Take me there</string>

    <!-- separators (the renderer never hard-codes punctuation: it comes from here) -->
    <string name="baopu_verify_join_or">", "</string>
    <string name="baopu_verify_line_sep">" | "</string>

    <!-- "another way" pre-fills the composer; sending stays her call -->
    <string name="baopu_verify_swap_prefill">That page did not come through. Let us try another way: open the page, stop there, and tell me step by step what to tap.</string>

    <!-- "note it down" writes into the todo ledger (batch 541 store, 565 board) -->
    <string name="baopu_verify_note_item">Noted: acceptance did not hold for this round (%1$s)</string>
    <string name="baopu_verify_note_source">verification of this round</string>
    <string name="baopu_verify_note_done">Added to the not-done list, ready to pick up later</string>
    <string name="baopu_verify_note_fail">This one did not get written (the todo ledger would not take it); the ledger on disk is unchanged</string>
    <string name="baopu_verify_detail_none">no item named yet</string>

    <!-- the 14 acceptance items of batch 332, in plain words (none may be missing:
         a missing name means an internal check id reaching the screen) -->
    <string name="baopu_verify_item_path_set">a file list that matches</string>
    <string name="baopu_verify_item_byte_identical">copies that are letter for letter identical</string>
    <string name="baopu_verify_item_no_escape">landings inside the agreed scope</string>
    <string name="baopu_verify_item_ledger_complete">a log row per file</string>
    <string name="baopu_verify_item_exists">the file that should be there</string>
    <string name="baopu_verify_item_structure">the section structure</string>
    <string name="baopu_verify_item_user_checklist">every item on your checklist ticked</string>
    <string name="baopu_verify_item_compile">code that builds</string>
    <string name="baopu_verify_item_tests_green">the relevant tests all green</string>
    <string name="baopu_verify_item_diff_in_scope">changes inside the declared scope</string>
    <string name="baopu_verify_item_budget">usage inside its ceiling</string>
    <string name="baopu_verify_item_shape">the expected row and column counts</string>
    <string name="baopu_verify_item_sample_5">sampled rows checked against the source</string>
    <string name="baopu_verify_item_reopenable">output that reopens cleanly</string>
</resources>
