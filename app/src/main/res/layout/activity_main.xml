<?xml version="1.0" encoding="utf-8"?>
<!--
  独立开发声明：本文件为本项目从零编写，未参考任何第三方同类应用的代码。
  视觉方向：macOS/Safari 窗口铬（公开设计惯例）——红黄绿圆点工具栏 + 圆角悬浮窗口卡片。
  结构：黑色桌面 → 圆角窗口卡片（工具栏 + 终端 + 快捷键条）。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:padding="6dp">

    <LinearLayout
        android:id="@+id/window_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/window_bg">

        <LinearLayout
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:orientation="horizontal"
            android:background="#FFFFFFFF"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <View
                android:id="@+id/btn_close"
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/traffic_dot"
                android:backgroundTint="#FFFF5F57"
                android:contentDescription="关闭终端"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/traffic_dot"
                android:backgroundTint="#FFFFBC2E" />

            <View
                android:id="@+id/btn_split"
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/traffic_dot"
                android:backgroundTint="#FF28C840"
                android:contentDescription="tmux 上下分屏"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/toolbar_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="证道"
                android:textColor="#FF1A1A1A"
                android:textSize="13sp"
                android:textStyle="bold"
                android:singleLine="true" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#FFE0E0E0" />

        <WebView
            android:id="@+id/terminal_web"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <HorizontalScrollView
            android:id="@+id/key_bar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#FFFFFFFF"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">

                <TextView
                    android:id="@+id/key_left"
                    style="@style/TermKey"
                    android:text="←" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/key_ctrl"
                    style="@style/TermKey"
                    android:text="CTRL" />
                <TextView
                    android:id="@+id/key_shift"
                    style="@style/TermKey"
                    android:text="SHIFT" />
                <TextView
                    android:id="@+id/key_esc"
                    style="@style/TermKey"
                    android:text="ESC" />
                <TextView
                    android:id="@+id/key_tab"
                    style="@style/TermKey"
                    android:text="TAB" />
                <TextView
                    android:id="@+id/key_up"
                    style="@style/TermKey"
                    android:text="↑" />
                <TextView
                    android:id="@+id/key_down"
                    style="@style/TermKey"
                    android:text="↓" />
                <TextView
                    android:id="@+id/key_pgup"
                    style="@style/TermKey"
                    android:text="PGUP" />
                <TextView
                    android:id="@+id/key_pgdn"
                    style="@style/TermKey"
                    android:text="PGDN" />
                <TextView
                    android:id="@+id/key_paste"
                    style="@style/TermKey"
                    android:text="粘贴" />
                <TextView
                    android:id="@+id/key_pipe"
                    style="@style/TermKey"
                    android:text="|" />
                <TextView
                    android:id="@+id/key_minus"
                    style="@style/TermKey"
                    android:text="-" />
                <TextView
                    android:id="@+id/key_slash"
                    style="@style/TermKey"
                    android:text="/" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/key_right"
                    style="@style/TermKey"
                    android:text="→" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>
</FrameLayout>
