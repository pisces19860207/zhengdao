<?xml version="1.0" encoding="utf-8"?>
<!--
  独立开发声明：本文件为本项目从零编写，未参考任何第三方同类应用的代码。
  视觉方向（2026-10-08 起）：手机全屏 + 一圈细白边 —— 黑底终端铺满可用区域，顶部一条扁平工具栏。
  历史：2026-10-05 起曾是「macOS/Safari 窗口铬」（白桌面 + 圆角悬浮卡片 + 四周 6dp
  白边 + 红黄绿圆点）。用户 2026-10-08 先反馈「终端的界面没有适配手机」，确认去掉那层
  桌面窗口外观（圆角卡片、6dp 白边）；同日晚再反馈「还是有个白色边框吧，不然四等边的
  手机看着好难受」⇒ **保留一圈白边但收细到 4dp**：纯黑铺到屏幕边缘时，屏幕与四等边机身
  黑成一片、看不出边界，反而更难受；留一圈白边能把屏幕范围交代清楚。
  红/黄/绿三个圆点保留（它们是功能键，不是装饰：关页 / 收分屏 / 分屏）。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/terminal_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:padding="4dp">

    <LinearLayout
        android:id="@+id/window_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#FF000000">

        <LinearLayout
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:orientation="horizontal"
            android:background="#FFFFFFFF"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <!-- 三个圆点是**功能键不是装饰**（红＝关闭终端 / 黄＝收分屏 / 绿＝分屏），
                 长按任意一个有说明。2026-10-08 走查改了两处：
                 1) 视觉仍是 11dp 的圆点（inset drawable 居中），但**热区 11dp → 30dp**
                    —— 红点是整页唯一的关闭出口，11dp 拇指够不到；
                 2) 加 foreground 涟漪 —— 原来按下去与松开**完全同色**，
                    加上无反馈的纯色圆点会被当成装饰。
                 取舍：热区占位变多 49dp，标题会被挤窄（已同时给标题加 ellipsize）。 -->
            <View
                android:id="@+id/btn_close"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/traffic_dot_red"
                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="关闭终端"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:id="@+id/btn_yellow"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/traffic_dot_yellow"
                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="关闭分屏"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:id="@+id/btn_split"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/traffic_dot_green"
                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="tmux 上下分屏"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/toolbar_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="证道"
                android:textColor="#FF1A1A1A"
                android:textSize="13sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <!-- 复制 / 粘贴：常驻顶部（借鉴同类终端的信息层级——放底部快捷键条
                 需要横向滑动才够得到，而这两个是高频操作）。蓝色文字、可点区域
                 含内边距，保证手指好按。2026-10-08 走查把上下内边距 8dp → 12dp，
                 使高度从约 34dp 达到约 40dp（受 42dp 工具条高度所限，此处无法再高）。 -->
            <TextView
                android:id="@+id/btn_copy_top"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="44dp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="复制"
                android:textColor="#FF2F6FE0"
                android:textSize="13sp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btn_paste_top"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="44dp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="粘贴"
                android:textColor="#FF2F6FE0"
                android:textSize="13sp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#FFE0E0E0" />

        <!-- 状态横幅：v3.9 起终端为原生 TerminalView，App 无法再像 xterm.js 那样
             往终端里注入显示文本（写入 pty 会变成 shell 输入）。安装/下载/解压等
             进度提示统一改由本横幅承载，关键节点另出 Toast，全部同步进 RunLog。 -->
        <TextView
            android:id="@+id/status_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFF4CE"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textColor="#FF5C4300"
            android:textSize="12sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:visibility="gone" />

        <!-- ⚠️ 背景色必须与 Termux 默认配色（黑底白字）一致，否则白字画在白底上
             完全看不见——2026-10-05 实测：会话/输入/引擎全部正常，屏幕却一片空白，
             只有带绿底的状态栏可见。TerminalRenderer.render 只在反色模式下填背景，
             常规渲染不填，背景必须由视图自身提供。 -->
        <com.termux.view.TerminalView
            android:id="@+id/terminal_native"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#FF000000"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <!-- 快捷键条：窄屏（<600dp）两行固定、宽屏（≥600dp）单行，
             由资源限定符 res/layout[-w600dp]/term_keys.xml 自动选择。
             两行会压缩终端可视高度，但不改变回滚缓冲策略。

             ⚠️ 外面这层容器是必需的：本 Activity 声明了 configChanges
             （旋转不重建，以免终端状态丢失），而资源限定符只在**布局加载时**
             匹配。所以旋转时必须由代码清空容器并重新 inflate，
             否则横屏会一直沿用竖屏的两行布局（2026-10-05 真机实测）。 -->
        <FrameLayout
            android:id="@+id/key_bar_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <include layout="@layout/term_keys" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
