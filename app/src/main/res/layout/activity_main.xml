<?xml version="1.0" encoding="utf-8"?>
<!--
  独立开发声明：本文件为本项目原创，不含对第三方源码的拷贝。
  视觉方向（2026-10-08 起）：手机全屏 + 一圈细白边 —— 黑底终端铺满可用区域，顶部一条扁平工具栏。
  历史：2026-10-05 起曾是「macOS/Safari 窗口铬」（白桌面 + 圆角悬浮卡片 + 四周 6dp
  白边 + 红黄绿圆点）。用户 2026-10-08 先反馈「终端的界面没有适配手机」，确认去掉那层
  桌面窗口外观（圆角卡片、6dp 白边）；同日晚再反馈「还是有个白色边框吧，不然四等边的
  手机看着好难受」⇒ **保留一圈白边但收细到 4dp**：纯黑铺到屏幕边缘时，屏幕与四等边机身
  黑成一片、看不出边界，反而更难受；留一圈白边能把屏幕范围交代清楚。
  红/黄/绿三个圆点保留（它们是功能键，不是装饰：关页 / 收分屏 / 分屏）。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/terminal_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp">

    <LinearLayout
        android:id="@+id/window_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#FF1C1B18">

        <LinearLayout
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:background="#FFF7F4ED"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <!-- 三个圆点是**功能键不是装饰**（红＝关闭终端 / 黄＝收分屏 / 绿＝分屏），
                 长按任意一个有说明。2026-10-08 走查改了两处：
                 1) 视觉仍是 11dp 的圆点（inset drawable 居中），但**热区 11dp → 30dp**
                    —— 红点是整页唯一的关闭出口，11dp 拇指够不到；
                 2) 加 foreground 涟漪 —— 原来按下去与松开**完全同色**，
                    加上无反馈的纯色圆点会被当成装饰。
                 取舍：热区占位变多 49dp，标题会被挤窄（已同时给标题加 ellipsize）。

                 B-补-20（2026-10-16）：热区 30dp → **48dp**（M3/Google 无障碍最小触摸目标），
                 工具条随之 44dp → 48dp。红点是整页唯一出口（左边缘右滑是它的等价物），
                 30dp 仍然偏小、拇指在移动中容易点空；圆点是 inset 居中的 drawable，
                 所以放大 View 只扩大热区、视觉尺寸不变。标题空间由 autoSize 兜底。
                  2026-10-18 真机回退（用户：三个点把「证道 - Debian 13.7」挤得没位置）：
                  热区 48 → **40dp**、间距 3/3/8 → 2/2/6（省 28dp 给标题）。40dp 仍大于原先 30dp
                  的"偏小"口径，视觉圆点尺寸不变（inset 居中）。这条是用户观感优先于 M3 48dp 的取舍。 -->
            <View
                android:id="@+id/btn_close"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/traffic_dot_red"
                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/term_close_terminal_cd"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:id="@+id/btn_yellow"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/traffic_dot_yellow"
                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/term_close_split_cd"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:id="@+id/btn_split"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/traffic_dot_green"
                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/term_split_cd"
                android:clickable="true"
                android:focusable="true" />

            <!-- 标题（2026-10-11 修「后面遮挡」）：17sp 粗体的
                 `证道 — Debian 13.7 · bash` 要 ~190dp，而 375dp 屏（1312px @560dpi）
                 在这条 14dp 内边距的 44dp 工具条里，扣掉三个圆点热区 104dp 与
                 复制/粘贴 ~92dp 后**只剩 ~150dp** ⇒ 尾巴「· bash」整段被省略号吃掉。
                 两处修：
                 1) 文案缩成 `证道 - Debian 13.7`（TerminalActivity 两处赋值同步改）；
                 2) 加 autoSize —— 更窄的屏上自动降号（12sp 起）也不截断；
                    ellipsize 只作极端窄屏的最后兜底。
                 注：回退态那条 `证道 — 系统 shell（环境未安装）` 更长，本次未动。
                 （B-补-20 后圆点热区 104 → 158dp、工具条 44 → 48dp，标题可用宽度再少 ~54dp；
                  autoSize 的下限 12sp 与 ellipsize 兜底不变，真机若见截断按本条口径再收。）

                 B-补-20（2026-10-16）：三个圆点热区 30 → **48dp**、工具条 44 → 48dp。
                 圆点是 inset 居中的 drawable（inset 同步 9.5 → 18.5dp），视觉仍是 11dp。 -->
            <TextView
                android:id="@+id/toolbar_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingStart="0dp"
                android:paddingEnd="32dp"
                android:text="@string/app_name"
                android:textColor="#FF1F1E1B"
                android:textSize="17sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="12sp"
                android:autoSizeMaxTextSize="17sp"
                android:autoSizeStepGranularity="1sp"
                android:ellipsize="end" />

            <!-- 复制 / 粘贴：常驻顶部（借鉴同类终端的信息层级——放底部快捷键条
                 需要横向滑动才够得到，而这两个是高频操作）。蓝色文字、可点区域
                 含内边距，保证手指好按。2026-10-08 走查把上下内边距 8dp → 12dp，
                 使高度从约 34dp 达到约 40dp（受 42dp 工具条高度所限，此处无法再高）。 -->
            <TextView
                android:id="@+id/btn_copy_top"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="36dp"
                android:gravity="center"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="@string/copy_text"
                android:textColor="#FF2C5F54"
                android:textSize="13sp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btn_paste_top"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="36dp"
                android:gravity="center"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="@string/paste_text"
                android:textColor="#FF2C5F54"
                android:textSize="13sp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#FFDCD7C9" />

        <!-- 状态横幅：v3.9 起终端为原生 TerminalView，App 无法再像 xterm.js 那样
             往终端里注入显示文本（写入 pty 会变成 shell 输入）。安装/下载/解压等
             进度提示统一改由本横幅承载，关键节点另出 Toast，全部同步进 RunLog。 -->
        <!-- 2026-10-10 UIUX 审计 B3 修：`singleLine` ⇒ `maxLines=3`。
             本横幅承载安装/下载/解压进度，而**最需要被看见的是失败原因**（例如
             「安装失败：… 校验不通过（重进 App 可再试）」）——单行 + 省略号会把最关键
             的那半句截掉，用户只能干瞪眼。上限 3 行：进度短句仍是 1 行、不占地方，
             失败长句能说完，也不至于把终端区挤没。 -->
        <!-- B-补-13（2026-10-16）：本横幅曾是「无形交互」——点一下会消失，界面却不说
             它可点。现在挂一个 ✕ 图标（`drawableEnd`，12dp，颜色同正文）+ `clickable`
             + `focusable`；读屏侧的「（点一下收起）」由 TerminalActivity 写
             `contentDescription` 时补，**正文一字不动**（`dismissNetworkBanner` 按文案
             精确比对「网络不通」那条，见其 KDoc）。 -->
        <TextView
            android:id="@+id/status_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFEDE8DC"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textColor="#FF856018"
            android:textSize="12sp"
            android:maxLines="3"
            android:ellipsize="end"
            android:drawableEnd="@drawable/ic_banner_dismiss"
            android:drawablePadding="6dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />

        <!-- 画布留白（2026-10-08）：这层容器是**留白的承载者**，不是装饰。
             ⚠️ 留白必须加在这一层，**绝不能直接给 TerminalView 设 padding**：
             TerminalView.updateSize() 用 getWidth()/getHeight() 算行列数（已核源码，行号以 main
             为准：`TerminalView.java:1032` 的 updateSize()，宽度取自 1033 行的 getWidth()、
             高度取自 1034 行的 getHeight()，**不减 padding**），渲染又固定从视图左上角起手。
             直接给它 padding 会同时造成两件坏事：① 列数按"含留白的宽度"算 ⇒ 最右几列
             被画在留白之外、看不见；② 留白根本不出现（字仍从边缘起手）。
             套一层容器后 TerminalView 自身变窄/变矮，getWidth() 天然等于内框宽度，
             内部所有计算保持不变——**一行 Java 都不用改**，这是本方案低风险的根据。
             留白档位（0 / 8 / 14dp）与底色由 TerminalPrefs.applyTo() 在进终端时写入。 -->
        <FrameLayout
            android:id="@+id/canvas_host"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="8dp"
            android:background="#FF1C1B18">

            <!-- ⚠️ 背景色必须与 Termux 配色一致，否则白字画在白底上完全看不见
                 ——2026-10-05 实测：会话/输入/引擎全部正常，屏幕却一片空白，
                 只有带绿底的状态栏可见。TerminalRenderer.render 只在反色模式下填背景，
                 常规渲染不填，背景必须由视图自身提供。
                 现在**容器与视图两处都要**（留白区由容器露出），换配色时一起变，
                 见 TerminalPrefs.applyTo()。 -->
            <com.termux.view.TerminalView
                android:id="@+id/terminal_native"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#FF1C1B18"
                android:focusable="true"
                android:focusableInTouchMode="true" />
        </FrameLayout>

        <!-- 快捷键条：窄屏（<600dp）两行固定、宽屏（≥600dp）单行，
             由资源限定符 res/layout[-w600dp]/term_keys.xml 自动选择。
             两行会压缩终端可视高度，但不改变回滚缓冲策略。

             ⚠️ 外面这层容器是必需的：本 Activity 声明了 configChanges
             （旋转不重建，以免终端状态丢失），而资源限定符只在**布局加载时**
             匹配。所以旋转时必须由代码清空容器并重新 inflate，
             否则横屏会一直沿用竖屏的两行布局（2026-10-05 真机实测）。 -->
        <FrameLayout
            android:id="@+id/key_bar_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFF5F5F7">

            <include layout="@layout/term_keys" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>