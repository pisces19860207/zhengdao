<?xml version="1.0" encoding="utf-8"?>
<!--
  独立开发声明：本文件为本项目从零编写，未参考任何第三方同类应用的代码。
  视觉方向：macOS/Safari 窗口铬（公开设计惯例）——红黄绿圆点工具栏 + 圆角悬浮窗口卡片。
  结构：黑色桌面 → 圆角窗口卡片（工具栏 + 终端 + 快捷键条）。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:padding="6dp">

    <LinearLayout
        android:id="@+id/window_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/window_bg">

        <LinearLayout
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:orientation="horizontal"
            android:background="#FFFFFFFF"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <View
                android:id="@+id/btn_close"
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/traffic_dot"
                android:backgroundTint="#FFFF5F57"
                android:contentDescription="关闭终端"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/traffic_dot"
                android:backgroundTint="#FFFFBC2E" />

            <View
                android:id="@+id/btn_split"
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/traffic_dot"
                android:backgroundTint="#FF28C840"
                android:contentDescription="tmux 上下分屏"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/toolbar_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="证道"
                android:textColor="#FF1A1A1A"
                android:textSize="13sp"
                android:textStyle="bold"
                android:singleLine="true" />

            <!-- 复制 / 粘贴：常驻顶部（借鉴同类终端的信息层级——放底部快捷键条
                 需要横向滑动才够得到，而这两个是高频操作）。蓝色文字、可点区域
                 含内边距，保证手指好按。 -->
            <TextView
                android:id="@+id/btn_copy_top"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:paddingEnd="6dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="复制"
                android:textColor="#FF2F6FE0"
                android:textSize="13sp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btn_paste_top"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="6dp"
                android:paddingEnd="2dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="粘贴"
                android:textColor="#FF2F6FE0"
                android:textSize="13sp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#FFE0E0E0" />

        <!-- 状态横幅：v3.9 起终端为原生 TerminalView，App 无法再像 xterm.js 那样
             往终端里注入显示文本（写入 pty 会变成 shell 输入）。安装/下载/解压等
             进度提示统一改由本横幅承载，关键节点另出 Toast，全部同步进 RunLog。 -->
        <TextView
            android:id="@+id/status_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFF4CE"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textColor="#FF5C4300"
            android:textSize="12sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:visibility="gone" />

        <!-- ⚠️ 背景色必须与 Termux 默认配色（黑底白字）一致，否则白字画在白底上
             完全看不见——2026-10-05 实测：会话/输入/引擎全部正常，屏幕却一片空白，
             只有带绿底的状态栏可见。TerminalRenderer.render 只在反色模式下填背景，
             常规渲染不填，背景必须由视图自身提供。 -->
        <com.termux.view.TerminalView
            android:id="@+id/terminal_native"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#FF000000"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <!-- 快捷键条：窄屏（<600dp）两行固定、宽屏（≥600dp）单行，
             由资源限定符 res/layout[-w600dp]/term_keys.xml 自动选择。
             两行会压缩终端可视高度，但不改变回滚缓冲策略。

             ⚠️ 外面这层容器是必需的：本 Activity 声明了 configChanges
             （旋转不重建，以免终端状态丢失），而资源限定符只在**布局加载时**
             匹配。所以旋转时必须由代码清空容器并重新 inflate，
             否则横屏会一直沿用竖屏的两行布局（2026-10-05 真机实测）。 -->
        <FrameLayout
            android:id="@+id/key_bar_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <include layout="@layout/term_keys" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
