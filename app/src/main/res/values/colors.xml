<?xml version="1.0" encoding="utf-8"?>
<!--
  独立开发声明：本文件为本项目维护，未参考任何第三方同类应用的代码。

  2026-10-14（§B 顺序 7 / issue #17 P4-6）：删掉 Android Studio 新建工程自带的
  8 个模板色（purple_200/500/700、teal_200/700、black、white）——全仓零引用
  （grep 实证：layout / manifest / mipmap / Kotlin 一律没处引），留着只会让
  下一个改配色的人以为"项目还有个紫青配色系统"。窗口背景 layout/window_bg.xml
  早已不在（模板残留的最后一环），此处同步收口。

  保留的 3 个是**真在被引用**的：
  - ic_launcher_background：启动图标背景（mipmap-anydpi/ic_launcher*.xml）
  - term_key_active / term_key_idle：终端功能键状态色（TerminalActivity 读取）
-->
<resources>
    <color name="ic_launcher_background">#FFFFFFFF</color>
    <!--
      term_key_active：终端粘滞键（CTRL/SHIFT）**按下态**的字色 —— 字贴在键栏底
      （`res/layout/term_keys.xml` 的 `@+id/key_bar`，#FFF5F5F7）上。

      B-补-25（2026-10-16）：原值 #FF18A018 在键栏底上只有 **3.17:1**（白底 3.45:1），
      低于 WCAG AA 正文线 4.5:1 —— 按下 CTRL 反而更难看清。改成同色相的深绿
      **#FF0F7A0F**：键栏底 5.06:1 / 白底 5.51:1 / 页面灰底 4.94:1，全部达 AA。
      判据钉在 `app/src/test/java/com/example/zhengdao/ui/theme/ContrastGuardTest.kt`
      （从本文件与布局取值、当场按 WCAG 公式复算），改色会红。
    -->
    <color name="term_key_active">#FF0F7A0F</color>
    <color name="term_key_idle">#FF222222</color>
</resources>
