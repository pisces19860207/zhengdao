<?xml version="1.0" encoding="utf-8"?>
<!-- 第二百九十一批（第二刀）：御医体检的**手动入口**文案。单独成文件（房型照 158/198 那几本）：
     共享 strings.xml 每批都有人碰，抽出来少一处冲突点，键名也一眼数得清。
     正式月位在 WorkManager 里（每 30 天、仅充电）；这一行只是"验收时随时能跑一趟"。 -->
<resources>
    <string name="settings_health_run">体检一次</string>
    <string name="settings_health_run_desc">只读账本、不弹卡；跑完把单子写进决策中心（月度自动跑一次）</string>
    <!-- 单子上来就自带「体检：」前缀（HealthRun.headline），这里不再重复一个 ⇒ 真机读数：
         「上次体检：4 处没接线、6 处未取样」，不是「上次体检：体检：…」 -->
    <string name="settings_health_done">上次%1$s</string>
    <string name="settings_health_failed">没跑成：%1$s</string>
    <!-- 第四百九十九批：授权档（严格/标准/放权）的人改入口。档位只能人改（点一行循环切），
         切档落治理账；体检行与管线闸读同一份。放权档不等于没人管：硬红线照样拒、
         不可逆无回收站照样问，被放过的动作仍记账。 -->
    <string name="ask_governance_tier_row">打扰治理档位</string>
    <string name="ask_governance_tier_desc">当前：%1$s（点击切换 严格→标准→放权；硬红线任何档都拒，被放过的动作仍记账）</string>
    <!-- 第五百一十一批：「后台自动维护」总开关（派工单 §三：设置里**只留这一个**，
         不再有"每日／每周／夜间"这类各自的小开关）。 -->
    <string name="settings_auto_maintenance">后台自动维护</string>
    <string name="settings_auto_maintenance_desc">开：抽检与巡按自己找时机跑｜关：两件都不启动（手动仍可以点）</string>
</resources>
