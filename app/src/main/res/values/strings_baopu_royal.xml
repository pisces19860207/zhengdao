<resources>
    <string name="royal_card_title">御案 · 请你定夺</string>
    <string name="royal_card_desc">御案卡（%1$s）：三行说清改什么、为什么、影不影响你</string>
    <string name="royal_mark_true">已核 · 真</string>
    <string name="royal_mark_unverified">未核实</string>
    <string name="royal_mark_false">假</string>
    <string name="royal_line_what">改什么</string>
