<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Zhengdao" parent="android:Theme.Material.Light.NoActionBar">
        <!-- 2026-10-10 改：补状态栏透明 + 浅色图标 + 键盘 resize，
             之前只有 1 行（parent + NoActionBar），状态栏是默认灰底黑图标，
             与浅色主题冲突。 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <!-- 2026-10-11 加：框架 AlertDialog 统一 iOS 风（14dp 圆角）。
             5 处 `android.app.AlertDialog.Builder` 不受 Compose 侧 shape 参数影响，
             只认这个属性；MainActivity ×3 + TerminalActivity ×2 一并生效。 -->
        <item name="android:alertDialogTheme">@style/Theme.ZhengdaoDialog</item>
    </style>

    <!-- 134 批 lint(Overdraw)：终端页专用主题。
         activity_main 根容器自带 `@android:color/white` 背景（4dp 白边），若主题也画
         windowBackground 就是两次全屏填充 ⇒ lint 判「重复绘制」。这里让**窗口不画底**
         （`@null`），白底只由根布局画一次：视觉逐像素不变（白边仍是纯白），少画一层。
         其余页仍用 Theme.Zhengdao。 -->

    <!-- 框架对话框主题：换背景 drawable（14dp 圆角 + 发丝描边）+ 按钮色统一 iOS 蓝。
         不覆盖文字/正文字体样式 —— 那些由 Android 12+ 的 Material 对话框默认
         主题提供，改了反而会在低版本设备上丢 Material 观感。
         2026-10-11 补（验收页 §4-2）：平台 Material 对话框的按钮文字走
         `?android:attr/colorAccent`，原先跟着系统默认 accent（偏绿），
         与 Compose 侧对话框的 iOS 蓝不一致 ⇒ 在对话框主题里单独钉死。 -->
    <style name="Theme.ZhengdaoDialog" parent="android:ThemeOverlay.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg_ios</item>
        <item name="android:colorAccent">#FF007AFF</item>
    </style>
</resources>