<?xml version="1.0" encoding="utf-8"?>
<!-- 独立开发声明：本文件为本项目从零编写，未参考任何第三方同类应用的代码。
     2026-10-08 走查补了 state_pressed：原来只有一个 item，按下去与松开**完全同色**，
     手感上像"没点到"。按压态加深一档（与系统按键同一逻辑）。
     2026-10-10 曾改深色（键条 #1C1C1E / 键面 #2C2C2E），理由是"与黑/琥珀/复古绿三种
     终端配色连成一片"。
     **2026-10-14 推翻（§B 顺序 34，用户拍板）**：改成与**系统键盘**一致的浅色方案——
     键面 #FFFFFF、按下 #D7D9DE、键条底 #F5F5F7、键字 #191919（取色读数见台账 §B 顺序 34）。
     推翻理由：功能键条的视觉基准应是用户手机上天天见的**系统键盘**，而不是终端底色；
     深色键条在浅色主题下也像"另一个 App 的部件"。
     描边保留一条极浅的 #E3E3E8 —— 键面 #FFFFFF 与键条底 #F5F5F7 只差一点点，
     没有它圆角边界会糊成一片。^C 仍走 key_button_danger_bg（红底白字，语义保留）。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 按下：与系统键盘的功能键同色 -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFD7D9DE" />
            <corners android:radius="8dp" />
            <stroke android:width="0.5dp" android:color="#FFC8CAD0" />
        </shape>
    </item>
    <!-- 常态：白键面 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="8dp" />
            <stroke android:width="0.5dp" android:color="#FFE3E3E8" />
        </shape>
    </item>
</selector>
