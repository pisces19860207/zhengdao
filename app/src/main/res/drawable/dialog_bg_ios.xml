<?xml version="1.0" encoding="utf-8"?>
<!--
  独立开发声明：本文件为本项目从零编写，未参考任何第三方同类应用的代码。

  2026-10-11 加：iOS 风格对话框背景（14dp 圆角 + 发丝描边 + 系统超亮底）。

  用途：给 values/themes.xml 里的 Theme.ZhengdaoDialog 用。
  5 处 `android.app.AlertDialog.Builder`（MainActivity ×3：版本过低 /
  存储授权 / 发现新版本；TerminalActivity ×2）走的是**框架**对话框，
  不受 Compose 侧 AlertDialog 的 shape 参数影响 —— 它们只认
  `android:alertDialogTheme`，所以改一处主题即全 5 处生效。

  圆角 14dp 与 Compose 侧 3 处 AlertDialog 对齐（见 ui/theme/Radius.kt
  的 rDialog 令牌），避免"同一屏里两种圆角的弹窗"。

  底色用 #F2F2F7（systemGroupedBackground）：框架对话框默认会画一层
  system 背景色，直接透出主题底色会偏灰；显式给一个浅底更接近 iOS alert。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#F2F2F7" />
    <corners android:radius="14dp" />
    <stroke
        android:width="0.5dp"
        android:color="#33000000" />
</shape>
