<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络权限：切片 3 的 RootFS 下载需要；本切片自身不联网 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 手机存储直通：把共享存储绑进 Debian 环境（工作区在 Download/证道）。
         ⚠️ READ 的 maxSdkVersion 帽子（原 32）已摘——2026-10-06 实测：Android 16 上
         该帽子导致 App 只有 WRITE 没有 READ，共享存储"能写（私有目录）不能读"，
         hermes 找不到用户文件的根因。 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <!-- target 28 的共享存储写通道：运行时请求，Android 11+ 对 target≤29 保持 legacy 视图 -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- 电池优化白名单（保活指南一键跳转用）：仅在用户确认后生效；
         该权限在 Play 商店受政策限制，本项目为 GitHub 旁加载分发，不受影响 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- M2 前台服务：targetSdk 28 起即需声明（API 34+ 才另需 foregroundServiceType） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <application
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:requestLegacyExternalStorage="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Zhengdao">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Zhengdao">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".TerminalActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.Zhengdao"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|density|uiMode" />

        <!-- M2 保活锚点：targetSdk 28 无需 foregroundServiceType -->
        <service
            android:name=".terminal.SessionService"
            android:exported="false" />
    </application>

</manifest>