<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络权限：切片 3 的 RootFS 下载需要；本切片自身不联网 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 网络状态：环境体检的「网络连通性」要读 activeNetwork 的能力。
         缺这条时 getNetworkCapabilities() 抛 SecurityException，被 runCatching 吞掉后
         该项**恒为 ✗**——与网络好坏无关（2026-10-07 真机复现：WiFi 已 VALIDATED，
         体检仍报"宿主网络未验证通过"）。normal 权限，声明即授予。 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 手机存储直通：把共享存储绑进 Debian 环境（工作区在 Download/证道）。
         ⚠️ READ 的 maxSdkVersion 帽子（原 32）已摘——2026-10-06 实测：Android 16 上
         该帽子导致 App 只有 WRITE 没有 READ，共享存储"能写（私有目录）不能读"，
         hermes 找不到用户文件的根因。 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <!-- target 28 的共享存储写通道：运行时请求，Android 11+ 对 target≤29 保持 legacy 视图 -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- 电池优化白名单（保活指南一键跳转用）：仅在用户确认后生效；
         该权限在 Play 商店受政策限制，本项目为 GitHub 旁加载分发，不受影响 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- M2 前台服务：targetSdk 28 起即需声明（API 34+ 才另需 foregroundServiceType） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <application
        android:name="com.example.zhengdao.ZhengdaoApp"
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:requestLegacyExternalStorage="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Zhengdao">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Zhengdao"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- ⚠️ 终端页的实例唯一性由**发起方的 Intent flag** 保证（见 MainActivity.terminalIntent），
             不用 android:launchMode：
               · singleTop —— 只在终端页已处于栈顶时才复用，问题是各入口都是从别处发起，
                 终端通常不在栈顶 ⇒ 挡不住新建实例；
               · singleTask —— 能强约束到全局唯一，但会把它塞进**独立 task**（真机实测 t4932
                 里只剩 TerminalActivity），于是清掉其上方的 MainActivity，红点关闭后不再
                 回主页，等于"退出即杀"，违反会话保活约定。
             CLEAR_TOP | SINGLE_TOP 组合在**同一个 task 内**达成同一目标：既有实例提到前台
             并走 onNewIntent，其上方 activity 被清理，下方的 MainActivity 保留 ⇒ 返回栈不变。
             会话保活不受影响：会话由 SessionManager + 前台服务持有，与 Activity 实例数无关。 -->
        <activity
            android:name=".TerminalActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.Zhengdao"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|density|uiMode" />

        <!-- M2 保活锚点：targetSdk 28 无需 foregroundServiceType -->
        <service
            android:name=".terminal.SessionService"
            android:exported="false" />
    </application>

</manifest>