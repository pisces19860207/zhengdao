<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络权限：切片 3 的 RootFS 下载需要；本切片自身不联网 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 网络状态：环境体检的「网络连通性」要读 activeNetwork 的能力。
         缺这条时 getNetworkCapabilities() 抛 SecurityException，被 runCatching 吞掉后
         该项**恒为 ✗**——与网络好坏无关（2026-10-07 真机复现：WiFi 已 VALIDATED，
         体检仍报"宿主网络未验证通过"）。normal 权限，声明即授予。 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 手机存储直通：把共享存储绑进 Debian 环境（工作区在 Download/证道）。
         ⚠️ READ 的 maxSdkVersion 帽子（原 32）已摘——2026-10-06 实测：Android 16 上
         该帽子导致 App 只有 WRITE 没有 READ，共享存储"能写（私有目录）不能读"，
         hermes 找不到用户文件的根因。 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <!-- 共享存储写通道（历史遗留，第㉕刀起已 inert）：targetSdk≤29 时运行时授予 WRITE 即可
         读写共享存储（legacy 视图）。抬到 36 后该权限**不再授予任何共享存储访问**（API 30+
         起系统对请求直接静默拒绝）——声明保留只为不动 StoragePermissionGuardTest 钉住的清单
         形态与历史口径；真实通道已切到「所有文件访问」，见 ProotLauncher.storageGranted。 -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- 电池优化白名单（保活指南一键跳转用）：仅在用户确认后生效；
         该权限在 Play 商店受政策限制，本项目为 GitHub 旁加载分发，不受影响 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- 通知权限（安卓 13+ 运行时权限，2026-10-09 补）：不声明/不请求时系统会静默丢掉
         本 App 的通知 —— 真机实测「装完自动清理 >500MB 的静默提示」因此从未出现过
         （`dumpsys package` 里 granted=false、`AppSettings importance=NONE`、通知列表为空）。
         冷启动时在 MainActivity 里按需请求（requestCode 101）。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- M2 前台服务：FOREGROUND_SERVICE 自 API 28 起即需声明；API 34+ 另需
         foregroundServiceType 与类型专属权限（第㉕刀抬 targetSdk 36 后两条都成了硬要求，
         见 SessionService 处的类型声明） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- specialUse 类型的专属权限（API 34+ 与 FOREGROUND_SERVICE_SPECIAL_USE 类型配对；
         安装时授予的 normal 权限）。选 specialUse 而不选 dataSync 的理由写在 SessionService
         注释里——dataSync 在 Android 15+ 有每天 6 小时累计上限，长会话会被系统掐断。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 唤醒锁（E-054，2026-10-09 补）：SessionService 全程 `PowerManager.newWakeLock(
         PARTIAL_WAKE_LOCK, "zhengdao:session")` 并 acquire()，但**这条权限一直没声明**
         ⇒ acquire() 抛 SecurityException → 被 `runCatching { … }` 静默吞掉 → 保活锁
         从来没真正持有过。唯一痕迹是 RunLog 每 30 秒一条「保活锁已失效，重新获取
         （会话仍在运行）」——看着在补，其实每轮都失败（"看着在跑，其实手机早就能睡"，
         正是 E-020 一类的静默降级）。合并清单（debug/release/benchmark）实测均无此权限。 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 相机（第二十二批 A 段，2026-10-18 用户拍板「相机权限」）：抱朴输入框的「＋ →
         拍照」。**只有拍照这一条路用它**，不申请任何存储新权限（附件落进工作区，
         工作区已由 MANAGE_EXTERNAL_STORAGE 覆盖）。运行时在 MainActivity/BaopuScreen
         里按需请求（见 BaopuComposer 的 RequestPermission）。 -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- 精确闹钟（第一百六十七批 · 定时任务 v1）：**只声明 SCHEDULE_EXACT_ALARM，
         不声明 USE_EXACT_ALARM**。两条的差别不是写法而是口径——
         · SCHEDULE_EXACT_ALARM 是 App-optimized 权限：Android 14 起对新装机**默认拒绝**，
           用户可在「设置 → 应用 → 特殊应用权限 → 闹钟和提醒」里单独给/撤（撤了还能撤回来），
           缺权限时 setExactAndAllowWhileIdle 抛 SecurityException，代码里 catch 住回落 WorkManager；
         · USE_EXACT_ALARM 是装机即授、**用户撤不掉**的 normal 权限，Google Play 把它限定给
           「闹钟/日历是核心功能」的 App 且要求提交时做权限声明申报（口径与日期见交付报告 §0.6）。
           一个「到点把一句话发进抱朴会话」不够格占这个名额 ⇒ 宁可默认非精确，也不替用户做主。
         页面上那行「精确闹钟」把这条降级说在人话里（ui/SettingsDataActivity 的权限卡）。 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- 第 129 批 lint 清债：CAMERA 权限要配一条 required=false 的 uses-feature，否则 lint 报
         PermissionImpliesUnsupportedChromeOsHardware（原意就是这个：没摄像头也能装，只是拍照按钮不可用）。 -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- 明文（cleartext）放行范围收窄（2026-10-12，用户交办）：
         改前这里是 android:usesCleartextTraffic="true" —— 全局放行，等于允许 App 与
         guest 内任何程序对任意域名发明文 HTTP。实际只用到两处（本机 oc serve 环回
         ＋ guest 的 apt 源），所以换成白名单式 network security config。
         ⚠️ 有 networkSecurityConfig 时，android:usesCleartextTraffic 会被忽略 ——
         所以那条已删掉，避免留下"看着全局放行、其实是白名单"的双口径。
         范围与理由逐条写在 app/src/main/res/xml/network_security_config.xml。 -->
    <application
        android:name="com.example.zhengdao.ZhengdaoApp"
        android:allowBackup="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:requestLegacyExternalStorage="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Zhengdao">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Zhengdao"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 第八十三批（§B 88）：外部入口只开三扇小门。launchMode=singleTop 让 App
                 已在前台时走 onNewIntent（与 onCreate 共用同一个路由判据）。
                 · 收分享：其他 App「分享文本」→ 抱朴输入框（只预填，不发送）；
                 · 收图片（第一百八十一批 #4）：SEND / SEND_MULTIPLE 的 image/* →
                   抱朴附件条（多选可多图；只预填、不自动发送、不自动上传，
                   与拍照/相册附件同一条链，见 BaopuComposer.saveAll）；
                 · zhengdao://ask?q=… → 抱朴；
                 · zhengdao://terminal?cmd=… → 终端（只预填到输入行，不带换行、不执行）。
                 **不声明 http/https**：那是玄览的浏览器地盘；也不收 file:// 与图片之外的
                 任意文件类型（text/plain 与 image/* 之外仍由路由层拒绝）。 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="ask"
                    android:scheme="zhengdao" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="terminal"
                    android:scheme="zhengdao" />
            </intent-filter>
            <!-- 第二百一十六批：MCP OAuth 回调（授权码 + PKCE 的 redirect_uri）。
                 只开 `zhengdao://mcp/oauth` 一条：系统浏览器授权完跳回来，
                 入口越窄越好（state 校验在 McpAuthFlow，路由只做形状判断）。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="mcp"
                    android:pathPrefix="/oauth"
                    android:scheme="zhengdao" />
            </intent-filter>
        </activity>
        <!-- ⚠️ 终端页的实例唯一性由**发起方的 Intent flag** 保证（见 MainActivity.terminalIntent），
             不用 android:launchMode：
               · singleTop —— 只在终端页已处于栈顶时才复用，问题是各入口都是从别处发起，
                 终端通常不在栈顶 ⇒ 挡不住新建实例；
               · singleTask —— 能强约束到全局唯一，但会把它塞进**独立 task**（真机实测 t4932
                 里只剩 TerminalActivity），于是清掉其上方的 MainActivity，红点关闭后不再
                 回主页，等于"退出即杀"，违反会话保活约定。
             CLEAR_TOP | SINGLE_TOP 组合在**同一个 task 内**达成同一目标：既有实例提到前台
             并走 onNewIntent，其上方 activity 被清理，下方的 MainActivity 保留 ⇒ 返回栈不变。
             会话保活不受影响：会话由 SessionManager + 前台服务持有，与 Activity 实例数无关。 -->
        <activity
            android:name=".TerminalActivity"
            android:exported="false"
            android:theme="@style/Theme.Zhengdao.Terminal"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|density|uiMode" />

        <!-- 输入回归页（Issue #2 / 设计方案 v3 §3）：APK 内置，进 30 秒回归 IME
             （同一套 vendored TerminalView 的 onCreateInputConnection，但会话跑 /system/bin/cat，
             所以没装运行环境也能回归）。exported=true 只为让 PC 侧用
             `adb shell am start -n com.example.zhengdao/.ui.ImeRegressionActivity` 一键起页，
             页面本身不读任何私有数据（只有一个本地 cat）。 -->
        <activity
            android:name=".ui.ImeRegressionActivity"
            android:exported="true"
            android:label="输入回归页"
            android:theme="@style/Theme.Zhengdao"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|density|uiMode" />

        <!-- 保活记录（被杀留档）二级页（2026-10-11）：原来这段内容内联在设置页的一张卡里，
             用户嫌"太多太长"，拆成独立页，设置页只留一行入口。
             exported=false（与输入回归页的有意区别）：只有本 App 设置页会拉起它，不需要
             `adb am start` 那种外部入口；而这一页会显示私有目录绝对路径与 logcat 片段，
             没有理由让别的 App 能直接把它调起来。
             configChanges 与终端页/输入回归页同款：转屏不重建，正在看的留档列表不会被重置。
             不写 windowSoftInputMode —— 本页没有任何输入控件（主题里已有 adjustResize）。 -->
        <activity
            android:name=".ui.KeepaliveLogActivity"
            android:exported="false"
            android:label="保活记录"
            android:theme="@style/Theme.Zhengdao"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|density|uiMode" />

        <!-- 开源许可（随包分发的第三方许可证正文）二级页（2026-10-11）：正文在 assets/licenses/，
             由 app/build.gradle.kts 的 stageLicenseAssets 在构建期从仓库根 licenses/ 与 LICENSE 装配。
             exported=false —— 只有设置页「关于」会拉起；本页只读 assets，不碰任何私有数据。
             configChanges 与保活记录页同款：转屏不重建，正在读的那份正文不会被重置。 -->
        <activity
            android:name=".ui.OpenSourceLicensesActivity"
            android:exported="false"
            android:label="开源许可"
            android:theme="@style/Theme.Zhengdao"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|density|uiMode" />

        <!-- 设置页二级页（2026-10-11 设置页重排）：原来 17 张卡挤在一个页面里，
             现在顶层只留「一句话状态 + 一次点击」，卡片内容一字未改地搬进这 6 页。
             exported=false —— 只有设置页会拉起；label 就是各页顶栏下那句人话；
             configChanges 与保活记录页同款：转屏不重建，页内正在跑的动作（下载/清理）不被打断。 -->
        <activity
            android:name=".ui.SettingsStorageActivity"
            android:exported="false"
            android:label="存储与缓存"
            android:theme="@style/Theme.Zhengdao"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|density|uiMode" />
        <activity
            android:name=".ui.SettingsEnvActivity"
            android:exported="false"
            android:label="环境与更新"
            android:theme="@style/Theme.Zhengdao"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|density|uiMode" />
        <activity
            android:name=".ui.SettingsDataActivity"
            android:exported="false"
            android:label="终端与资料"
            android:theme="@style/Theme.Zhengdao"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|density|uiMode" />
        <activity
            android:name=".ui.SettingsKeepaliveActivity"
            android:exported="false"
            android:label="后台与保活"
            android:theme="@style/Theme.Zhengdao"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|density|uiMode" />
        <!-- 浏览器桥（2026-10-15，设计文档 §4.5）：给终端里的 agent 用；默认关，页面里拨开关才 bind 127.0.0.1:14080 -->
        <activity
            android:name=".ui.SettingsBridgeActivity"
            android:exported="false"
            android:label="浏览器桥"
            android:theme="@style/Theme.Zhengdao"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|density|uiMode" />
        <!-- 定时任务页（第一百六十七批 §1）：列表（启停/编辑/删除/下次运行/上次结果）＋新建表单。
             与其余设置二级页同一套（exported=false：只有设置页 Hub 会拉起；configChanges 同款：
             转屏不重建，正在填的表单不会被清空）。
             label 走 @string（这一页是新页，没有"逐字搬过来的旧标题"要保）：切英文时任务栏与
             最近任务列表里的页名跟着变；其余二级页的中文 label 是历史形态，本批不动它们。 -->
        <activity
            android:name=".schedule.ScheduleTasksActivity"
            android:exported="false"
            android:label="@string/sched_page_title"
            android:theme="@style/Theme.Zhengdao"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|density|uiMode" />
        <activity
            android:name=".ui.SettingsHelpActivity"
            android:exported="false"
            android:label="帮助"
            android:theme="@style/Theme.Zhengdao"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|density|uiMode" />
        <activity
            android:name=".ui.SettingsAboutActivity"
            android:exported="false"
            android:label="关于"
            android:theme="@style/Theme.Zhengdao"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|density|uiMode" />

        <!-- M2 保活锚点：Debian 会话的前台服务（前台通知 + WakeLock + 30 秒软监控）。
             foregroundServiceType（API 34+ 起；targetSdk 34+ 不声明就抛
             MissingForegroundServiceTypeException）= **specialUse**：
             · 不选 dataSync —— Android 15+ 起该类型每天累计 6 小时后系统会 onTimeout 停掉
               服务，长会话必死（本服务的用户场景恰恰是几小时到几天的终端会话）；
             · 也不属 connectedDevice / mediaProcessing 等任何既有类型 ⇒ 落在「其他类型
               覆盖不到」的 specialUse（同类免 root Linux 环境产品的同一选择）。
             subtype 属性是 API 34+ 对 specialUse 的强制项（Play 政策要求说明为何其他类型
               不合适；本项目走 GitHub 直发不受政策约束，但仍按规范写全）。 -->
        <service
            android:name=".terminal.SessionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Long-running terminal session keepalive: a user-driven Debian shell session must survive leaving the terminal UI, and no other FGS type covers a long shell session" />
        </service>

        <!-- 精确闹钟的落点（第一百六十七批 §3）：**必须是清单里的静态组件**，不能
             Context.registerReceiver —— AlarmManager 登记的 PendingIntent 要跨进程重启生效，
             动态注册的接收器在重启后不存在，打到的闹钟会因为找不到组件而静默丢掉。
             exported=false：Intent 显式指向本类（schedule/ScheduleAlarmReceiver.kt），
             没有任何外部 App 需要能调它；也不需要 intent-filter（不是隐式广播）。
             接收器本身不发消息，只把进程叫醒后交给与 WorkManager 同一趟 pass。 -->
        <receiver
            android:name=".schedule.ScheduleAlarmReceiver"
            android:exported="false" />

        <!-- 抱朴附件（第二十二批 A 段）：相机要一个可写 Uri，安卓 7+ 只能是 content://，
             故用 FileProvider **只**暴露缓存里的 `baopu-camera/`（见 res/xml/baopu_file_paths.xml）。
             exported=false + grantUriPermissions=true：只有我们临时授权的那个 Uri 能被相机写，
             别的 App 拿不到任何路径。authority 用 ${applicationId} 前缀，debug/release 不撞。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.baopu.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/baopu_file_paths" />
        </provider>
    </application>

</manifest>