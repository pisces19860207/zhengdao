            android:label="@string/baopu_authz_preview_launcher"
            android:theme="@style/Theme.Zhengdao">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
