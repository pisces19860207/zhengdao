<?xml version="1.0" encoding="utf-8"?>
<!--
  第二百四十一批（终端解耦第二刀）：终端/体检用到的字符串**随代码搬到这里**。

  搬家时先在 :app 留过一份同值副本（怕体检页 UI 还在读它），实测 lint 直接把这 13 条判成
  `UnusedResources` —— 说明 :app 侧已经没有任何引用（引用方全跟着代码过来了）。
  于是按 lint 的结论**删掉 :app 那份**，这里就是唯一真源：一条文案只在一个地方改。

  搬来的清单：text_selection_more（终端长按菜单）、hermes_*（HermesEnv）、resmon_*（ResMonitor）。
  留在 :app 的：copy_text / paste_text（抱朴的复制按钮还在用）。
-->
<resources>
    <!-- 终端长按菜单（com.termux.textselection.TextSelectionCursorController） -->
    <string name="copy_text">复制</string>
    <string name="paste_text">粘贴</string>
    <string name="text_selection_more">更多</string>

    <!-- ── Hermes 依赖体检（HermesEnv）── -->
    <string name="hermes_not_installed">未安装 Hermes，跳过</string>
    <string name="hermes_record_host_path">依赖环境记录写的是宿主路径（proot 里看不见），可一键修正（盘上有可用的代）</string>
    <string name="hermes_record_broken">依赖环境记录指向不存在的目录，可一键修正（盘上有可用的代）</string>
    <string name="hermes_record_lost">依赖环境已丢失，需在终端重建（点「修复」会在终端里跑，过程可见）</string>
    <string name="hermes_no_record">尚未登记依赖环境（安装可能没跑完），需在终端重建</string>
    <string name="hermes_lock_missing">源码锁 uv.lock 缺失（每次启动会报警告），可在终端一键补回</string>
    <plurals name="hermes_ok_stale">
        <item quantity="other">依赖环境记录有效（另有 %1$d 个更新中断留下的标记文件，可一键清理）</item>
    </plurals>
    <string name="hermes_ok">依赖环境记录有效</string>

    <!-- ── 资源占用体检（ResMonitor）── -->
    <string name="resmon_idle">抱朴与终端均未运行，无进程可采样</string>
    <plurals name="resmon_rss_over">
        <item quantity="other">⚠ 内存 %1$d MB 超阈值 %2$d MB（%3$d 个进程）——关掉不用的会话，或重启抱朴</item>
    </plurals>
    <string name="resmon_cpu_over">⚠ CPU %1$s%% 超阈值 %2$d%%——检查插件与会话规模</string>
    <plurals name="resmon_normal">
        <item quantity="other">RSS %1$d MB · CPU %2$s%% · %3$d 个进程</item>
    </plurals>
</resources>
